// ==========================================================================
//  E-COMMERCE ANALYTICS  |  DAX MEASURE LIBRARY
// ==========================================================================
//  GENERATED by dashboard/build_pbip.py - do not edit by hand.
//  The same definitions are emitted into the TMDL semantic model, so this
//  file and the model cannot disagree. Edit MEASURES in build_pbip.py.
//
//  All measures live on the fact_sales table.
// ==========================================================================


// ---- 01 Core -----------------------------------------------------------

// Net revenue, already net of discount.
// Verified: reports/data_quality_report.md s10.
Total Revenue =
    SUM ( fact_sales[revenue] )
// format: "$"#,0

// Derived exactly as revenue - profit.
// Not a modelled assumption.
Total Cost =
    SUM ( fact_sales[cost] )
// format: "$"#,0

// Real profit from the source data.
Total Profit =
    SUM ( fact_sales[profit] )
// format: "$"#,0

// Units sold.
Total Units =
    SUM ( fact_sales[quantity] )
// format: #,0

// Order-line count.
Order Lines =
    COUNTROWS ( fact_sales )
// format: #,0

// Counts the COMPOSITE order key.
// Counting order_id instead returns 25,035 because order_id is reused across customers and dates.
// Expected: 25,754.
Total Orders =
    DISTINCTCOUNT ( fact_sales[order_key] )
// format: #,0

// Counts the RESOLVED person.
// Counting a raw customer_id returns 1,590 because every person has two ids.
// Expected: 795.
Total Customers =
    DISTINCTCOUNT ( fact_sales[customer_key] )
// format: #,0

// Distinct products.
Total Products =
    DISTINCTCOUNT ( fact_sales[product_key] )
// format: #,0


// ---- 02 Profitability --------------------------------------------------

// Profit over revenue.
// Expected 11.61%.
Profit Margin % =
    DIVIDE ( [Total Profit], [Total Revenue] )
// format: 0.0%

// Pre-discount revenue: revenue / (1 - discount).
Total List Revenue =
    SUM ( fact_sales[list_revenue] )
// format: "$"#,0

// Total discount surrendered.
// Expected $2,363,988.
Discount Given =
    SUM ( fact_sales[discount_amount] )
// format: "$"#,0

// Expected 15.75%.
Discount % of List =
    DIVIDE ( [Discount Given], [Total List Revenue] )
// format: 0.0%

// Mean line-level discount.
Average Discount % =
    AVERAGE ( fact_sales[discount] )
// format: 0.0%

// Lines with negative profit.
// Expected 12,544.
Loss-Making Lines =
    SUM ( fact_sales[is_loss_making] )
// format: #,0

// Expected 24.46%.
Loss-Making Line % =
    DIVIDE ( [Loss-Making Lines], [Order Lines] )
// format: 0.0%

// Sum of negative profit.
// Expected -$920,646.
Total Loss =
    CALCULATE ( [Total Profit], KEEPFILTERS ( fact_sales[is_loss_making] = 1 ) )
// format: "$"#,0

// Reported SEPARATELY, never netted into profit.
Total Shipping Cost =
    SUM ( fact_sales[shipping_cost] )
// format: "$"#,0

// Expected 10.70%.
Shipping % of Revenue =
    DIVIDE ( [Total Shipping Cost], [Total Revenue] )
// format: 0.0%

// SCENARIO ONLY.
// Whether shipping is already inside profit cannot be determined from this extract.
// Do not use on a KPI card.
Profit After Shipping (scenario) =
    [Total Profit] - [Total Shipping Cost]
// format: "$"#,0


// ---- 03 Order value ----------------------------------------------------

// Expected $490.89.
Average Order Value =
    DIVIDE ( [Total Revenue], [Total Orders] )
// format: "$"#,0

// Expected $201.30.
// Show this NEXT TO average - the mean is 2.44x the median, so AOV alone overstates a typical order by 144%.
Median Order Value =
    MEDIANX ( VALUES ( fact_sales[order_key] ), CALCULATE ( [Total Revenue] ) )
// format: "$"#,0

// Mean profit per order.
Average Order Profit =
    DIVIDE ( [Total Profit], [Total Orders] )
// format: "$"#,0

// Basket size per ORDER.
Units per Order =
    DIVIDE ( [Total Units], [Total Orders] )
// format: 0.00

// Units per ORDER LINE - the figure the discount analysis uses.
// Flat at 3.40-3.81 from 0% to 50% discount, then FALLS to 2.84 above 50%.
// Use this, not Units per Order, on any discount-versus-volume visual, so the dashboard matches the notebook.
Units per Line =
    DIVIDE ( [Total Units], [Order Lines] )
// format: 0.00

// Distinct products per order.
Lines per Order =
    DIVIDE ( [Order Lines], [Total Orders] )
// format: 0.00

// Expected ~32.4.
Orders per Customer =
    DIVIDE ( [Total Orders], [Total Customers] )
// format: 0.0

// Historical realised value.
Revenue per Customer =
    DIVIDE ( [Total Revenue], [Total Customers] )
// format: "$"#,0


// ---- 04 Returns --------------------------------------------------------

// Orders in markets where returns were actually recorded.
// The ONLY valid denominator for a return rate here.
// Expected 20,717.
Measured Orders =
    CALCULATE ( [Total Orders], KEEPFILTERS ( fact_sales[returns_measured] = 1 ) )
// format: #,0

// Orders in Africa/Canada/EMEA, which have NO return records.
// Expected 5,037.
Unmeasured Orders =
    CALCULATE ( [Total Orders], KEEPFILTERS ( fact_sales[returns_measured] = 0 ) )
// format: #,0

// Expected 1,203.
Returned Orders =
    CALCULATE ( [Total Orders], KEEPFILTERS ( fact_sales[return_flag] = 1 ), KEEPFILTERS ( fact_sales[returns_measured] = 1 ) )
// format: #,0

// Expected 5.81%.
Return Rate % =
    DIVIDE ( [Returned Orders], [Measured Orders] )
// format: 0.0%

// USE THIS IN ANY VISUAL SLICED BY MARKET.
// Returns BLANK - not 0% - where no market in context has returns data, so Africa/Canada/EMEA render as a gap instead of a perfect returns record they never earned.
Return Rate % (safe) =
    IF ( [Measured Orders] > 0, DIVIDE ( [Returned Orders], [Measured Orders] ) )
// format: 0.0%

// Expected $818,044.
Returned Revenue =
    CALCULATE ( [Total Revenue], KEEPFILTERS ( fact_sales[return_flag] = 1 ), KEEPFILTERS ( fact_sales[returns_measured] = 1 ) )
// format: "$"#,0


// ---- 05 Time -----------------------------------------------------------

// Requires dim_date marked as the model date table.
Revenue PY =
    CALCULATE ( [Total Revenue], SAMEPERIODLASTYEAR ( dim_date[date] ) )
// format: "$"#,0

// Year-on-year growth.
// 2012 +18.5%, 2013 +27.2%, 2014 +26.3%.
Revenue YoY % =
    VAR Prior = [Revenue PY]
    RETURN IF ( NOT ISBLANK ( Prior ), DIVIDE ( [Total Revenue] - Prior, Prior ) )
// format: +0.0%;-0.0%

// Prior-year profit.
Profit PY =
    CALCULATE ( [Total Profit], SAMEPERIODLASTYEAR ( dim_date[date] ) )
// format: "$"#,0

// Year-on-year profit growth.
Profit YoY % =
    VAR Prior = [Profit PY]
    RETURN IF ( NOT ISBLANK ( Prior ), DIVIDE ( [Total Profit] - Prior, Prior ) )
// format: +0.0%;-0.0%

// Month-on-month growth.
Revenue MoM % =
    VAR Prior = CALCULATE ( [Total Revenue], DATEADD ( dim_date[date], -1, MONTH ) )
    RETURN IF ( NOT ISBLANK ( Prior ), DIVIDE ( [Total Revenue] - Prior, Prior ) )
// format: +0.0%;-0.0%

// Year to date.
Revenue YTD =
    TOTALYTD ( [Total Revenue], dim_date[date] )
// format: "$"#,0

// Smooths the monthly series, which is dominated by a Nov-Dec peak.
Revenue 3M Rolling Avg =
    AVERAGEX ( DATESINPERIOD ( dim_date[date], MAX ( dim_date[date] ), -3, MONTH ), CALCULATE ( [Total Revenue] ) )
// format: "$"#,0

// Uses the INACTIVE ship-date relationship.
// This is why dim_date has two relationships to the fact table.
Revenue Shipped (by ship date) =
    CALCULATE ( [Total Revenue], USERELATIONSHIP ( fact_sales[ship_date_key], dim_date[date_key] ) )
// format: "$"#,0


// ---- 06 Fulfilment -----------------------------------------------------

// ORDER-TO-SHIP lag.
// The dataset has NO delivery date, so this is not delivery time and there is no genuine late-delivery rate.
Avg Ship Lag Days =
    AVERAGEX ( VALUES ( fact_sales[order_key] ), CALCULATE ( MAX ( fact_sales[ship_lag_days] ) ) )
// format: 0.00

// Expected 7.
Max Ship Lag Days =
    MAX ( fact_sales[ship_lag_days] )
// format: #,0


// ---- 07 Customers ------------------------------------------------------

// Expected 795 - every customer is a repeat customer.
Repeat Customers =
    COALESCE ( COUNTROWS ( FILTER ( VALUES ( dim_customer[customer_key] ), [Total Orders] > 1 ) ), 0 )
// format: #,0

// DEGENERATE: expected 0.
// COALESCE forces a literal 0 rather than BLANK, so the card reads '0' instead of '(Blank)' - the point is that zero one-time customers exist, and a blank card fails to say that.
One-Time Customers =
    COALESCE ( COUNTROWS ( FILTER ( VALUES ( dim_customer[customer_key] ), [Total Orders] = 1 ) ), 0 )
// format: #,0

// DEGENERATE: expected 100% by construction.
// Carries no information here.
Repeat Purchase Rate % =
    DIVIDE ( [Repeat Customers], [Total Customers] )
// format: 0.0%

// Mean days since last purchase.
// Exists as a MEASURE because a scatter chart cannot put a raw column on an axis without an explicit aggregation.
Avg Recency Days =
    AVERAGE ( dim_customer[days_since_last_purchase] )
// format: 0.0

// Mean lifetime revenue per customer, for the recency-vs-value scatter.
Avg Customer Revenue =
    AVERAGE ( dim_customer[lifetime_revenue] )
// format: "$"#,0

// Customers whose FIRST order is in context - the correct definition of new.
// Non-zero only in 2011: the panel is closed after year one.
New Customers =
    CALCULATE ( DISTINCTCOUNT ( dim_customer[customer_key] ), USERELATIONSHIP ( dim_customer[first_order_date_key], dim_date[date_key] ) )
// format: #,0

// Expected 67.
// Real revenue, negative lifetime profit.
Unprofitable Customers =
    CALCULATE ( DISTINCTCOUNT ( dim_customer[customer_key] ), KEEPFILTERS ( dim_customer[is_unprofitable] = 1 ) )
// format: #,0

// Expected ~30%, NOT ~80%.
// The Pareto assumption fails on this dataset (Gini 0.18), so there is no top tier to protect.
Top 20% Customer Revenue Share % =
    VAR TotalRev = [Total Revenue]
    VAR N = ROUNDUP ( DISTINCTCOUNT ( dim_customer[customer_key] ) * 0.2, 0 )
    VAR TopCustomers =
        TOPN ( N, VALUES ( dim_customer[customer_key] ), [Total Revenue], DESC )
    VAR TopRev = SUMX ( TopCustomers, [Total Revenue] )
    RETURN DIVIDE ( TopRev, TotalRev )
// format: 0.0%


// ---- 09 Notes ----------------------------------------------------------

// Put this on the Operations page so the coverage gap cannot be missed.
Returns Coverage Note =
    VAR Unmeasured = [Unmeasured Orders]
    RETURN IF ( Unmeasured > 0,
        "Return rate excludes " & FORMAT ( Unmeasured, "#,0" ) &
        " orders in markets with no returns data (Africa, Canada, EMEA)",
        "All orders in scope have returns data" )

// Puts the dataset's limits on the report rather than in a footnote.
Dataset Caveat =
    "795-customer closed panel, all acquired 2011. No one-time customers, no demographics, no payment method, no order status. Returns unmeasured in Africa/Canada/EMEA."

